    {
      "id": "71533be3-e0b1-46de-8317-e96e07f8c18f",
      "name": "Extract Text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Why Code: strip HTML to plain text and cap the LLM input length\nconst post = $input.first().json.posts[0];\nconst text = String(post.html || '')\n  .replace(/<script[\\s\\S]*?<\\/script>/gi, ' ')\n  .replace(/<style[\\s\\S]*?<\\/style>/gi, ' ')\n  .replace(/<[^>]+>/g, ' ')\n  .replace(/&nbsp;/g, ' ').replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '\"').replace(/&#39;/g, \"'\")\n  .replace(/\\s+/g, ' ').trim();\nconst tags = (post.tags || []).map(t => t.name).filter(n => n && !n.startsWith('#'));\nreturn [{ json: {\n  post_id: post.id,\n  slug: post.slug,\n  title: post.title,\n  url: post.url,\n  excerpt: post.custom_excerpt || post.excerpt || '',\n  tags,\n  body: text.slice(0, 6000)\n} }];"
      }
    },
    {
      "id": "64c109b8-bd71-42c4-b15f-998f251a5ff9",
      "name": "Curate Toot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Settings').first().json.llmUrl }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ { model: $('Settings').first().json.model, temperature: 0.7, messages: [ { role: 'system', content: $('Settings').first().json.systemPrompt }, { role: 'user', content: 'Title: ' + $json.title + '\\nExcerpt: ' + $json.excerpt + '\\nTags: ' + $json.tags.join(', ') + '\\n\\nArticle:\\n' + $json.body } ] } }}",
        "options": {
          "timeout": 120000
        }
      },
      "credentials": {
        "openAiApi": {
          "id": "o8pN7jD1z9bsiFOh",
          "name": "OpenAi account"
        }
      }
    },
    {
      "id": "df8505bf-6195-4a82-9fa3-e68b3087c940",
      "name": "Build Status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Why Code: parse the LLM JSON defensively and enforce the 500-char Mastodon limit\nconst raw = ($input.first().json.choices || [])[0]?.message?.content || '';\nlet parsed = {};\ntry { parsed = JSON.parse(raw); } catch (e) {\n  const m = raw.match(/\\{[\\s\\S]*\\}/);\n  if (m) { try { parsed = JSON.parse(m[0]); } catch (e2) {} }\n}\nconst meta = $('Extract Text').first().json;\nconst maxToot = $('Settings').first().json.maxTootChars;\nlet toot = String(parsed.toot || '').replace(/#[a-zA-Z0-9_]+/g, '').replace(/\\s+/g, ' ').trim() || meta.title;\nconst tags = (Array.isArray(parsed.hashtags) ? parsed.hashtags : [])\n  .map(t => String(t).replace(/^#/, '').replace(/[^a-zA-Z0-9_]/g, '').toLowerCase())\n  .filter(Boolean).slice(0, 3).map(t => '#' + t);\nconst suffix = '\\n\\n' + meta.url + (tags.length ? '\\n\\n' + tags.join(' ') : '');\nconst room = Math.min(maxToot, 500 - suffix.length);\nif (toot.length > room) toot = toot.slice(0, room - 1).trimEnd() + '…';\nreturn [{ json: { status: toot + suffix, post_id: meta.post_id, slug: meta.slug, title: meta.title } }];"
      }
    },
