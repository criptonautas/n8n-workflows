        "type": "n8n-nodes-base.if",
        "typeVersion": 2.4,
        "position": [
          880,
          300
        ],
        "parameters": {
          "conditions": {
            "combinator": "and",
            "options": {
              "caseSensitive": true,
              "leftValue": "",
              "typeValidation": "strict",
              "version": 2
            },
            "conditions": [
              {
                "id": "c-status",
                "leftValue": "={{ $json.posts[0].status }}",
                "rightValue": "published",
                "operator": {
                  "type": "string",
                  "operation": "equals"
                }
              },
              {
                "id": "c-visibility",
                "leftValue": "={{ $json.posts[0].visibility }}",
                "rightValue": "public",
                "operator": {
