      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Webhook paths work as passwords: keep them out of the public backup.\nconst clean = (nodes) => {\n  for (const node of nodes ?? []) {\n    delete node.webhookId;\n    if (node.parameters && \"path\" in node.parameters) {\n      node.parameters.path = \"redacted\";\n    }\n  }\n};\n\nreturn $input\n  .all()\n  .filter((item) => !item.json.isArchived)\n  .map((item) => {\n    const wf = JSON.parse(JSON.stringify(item.json));\n    delete wf.pinData;\n    clean(wf.nodes);\n    clean(wf.activeVersion?.nodes);\n    return { json: wf };\n  });"
      },
      "notes": "Why Code: deep-clean of every node in each workflow. Webhook paths act as passwords, so they never reach the public repo."
    },
